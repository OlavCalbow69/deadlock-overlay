root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sln,vcxproj,filters,ps1}]
end_of_line = crlf

[*.{cpp,h,hlsl}]
indent_style = space
indent_size = 4

[*.{vcxproj,filters,sln,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/generated/fonts/geist_data.cpp]
trim_trailing_whitespace = false

[thirdparty/**]
trim_trailing_whitespace = false
